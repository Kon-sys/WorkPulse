@startuml
skinparam monochrome true
skinparam shadowing false
title Анализ активности – диаграмма деятельности
start
:Проверить tenant, сотрудника, устройства,\nполитику, период и срок актуальности;
if (Данные корректны?) then (нет)
  :BusinessRuleException;
  stop
else (да)
endif
:Дедупликация по device + client_event_id;\nконфликт payload – исключение;
:Сортировка по времени события\nи стабильным ключам;
:Границы: события, истечение сигнала,\nперерывы, начало и конец периода;
while (Остался интервал?) is (да)
  :Обновить состояния устройств;
  if (Есть открытый перерыв?) then (да)
    :Lunch / AuthorizedAbsence / Unknown;
  else (нет)
    if (Есть актуальное активное устройство?) then (да)
      :Выбрать по последнему вводу\nи стабильному порядку устройств;
      :Классифицировать ресурс по версии политики;\nнеизвестный ресурс – Neutral;
    else (нет)
      if (Все устройства подтвердили idle?) then (да)
        :Idle;
      else (нет)
        :Unknown;
      endif
    endif
  endif
  :Добавить интервал; объединить\nсоседние одинаковые категории;
endwhile (нет)
:Проверить непрерывные Idle / NonTarget / Lunch\nна строгое превышение лимита;
:Создать новый запуск анализа\nи Append в хранилище;
stop
@enduml
